<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <supports-screens
        android:anyDensity="true"
        android:resizeable="true"
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true" />

    <application>

        <activity
            android:name=".ui.activity.HomeActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Splash"
            android:windowSoftInputMode="adjustPan">

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="smb" />
                <data android:scheme="rtmp" />
                <data android:scheme="rtsp" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="ed2k" />
                <data android:scheme="magnet" />
                <data android:scheme="thunder" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.SearchActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".ui.activity.FileActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.FolderActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.HistoryActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.KeepActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.LiveActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.activity.HomeActivity"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.activity.ScanActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.VideoActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.activity.HomeActivity"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.activity.PluginActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.DownloadActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <!-- 实验室：独立包 ui.lab -->
        <activity
            android:name=".ui.lab.LabHomeActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="fullUser" />
        <activity
            android:name=".ui.lab.LabSettingActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="fullUser" />
        <activity
            android:name=".ui.lab.LabEnvActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="fullUser" />
        <activity
            android:name=".ui.lab.LabServiceActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="fullUser" />
        <activity
            android:name=".ui.lab.LabLogActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="fullUser" />
        <activity
            android:name=".ui.lab.LabPasteImportActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="fullUser" />
        <activity
            android:name=".ui.lab.LabInstallActivity"
            android:exported="true"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.lab" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.lab.LabLiveOutputActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="fullUser" />
        <activity
            android:name=".ui.lab.LabTerminalActivity"
            android:theme="@style/Theme.Lab"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:screenOrientation="fullUser"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".ui.lab.LabKeepAlive"
            android:exported="false" />

        <!-- 旧实验室：播放器实验开关页，从实验室设置进入 -->
        <activity
            android:name=".ui.activity.LabActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.EnhancedActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.PanLoginActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.MiniAppActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.PythonPackagesActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout" />

        <receiver
            android:name=".receiver.ShortcutReceiver"
            android:exported="false" />

        <service
            android:name=".service.DLNACastService"
            android:exported="false" />

    </application>
</manifest>
